views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "Movies"
        - "!cover.isEmpty()"
    order:
      - file.name
      - genre
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 220
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
